VK_ACCESS_TOKEN_GROUPS_OWNER=your_groups_owner_token # токен аккаунта, от имени которого будут созданы группы
VK_ACCESS_TOKEN_ADMIN_ACCOUNT=your_admin_account_token # токен аккаунта, от имени которого нужно подписаться на группы и которому нужно дать права админа
VK_ADMIN_ACCOUNT_USER_ID=your_admin_account_user_id # id аккаунта, от имени которого нужно подписаться на группы и которому нужно дать права админа
VK_API_VERSION=5.131 # версия api vk.com

GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id # id таблицы google. # ID таблицы берется из URL: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit
GOOGLE_SHEETS_SHEET_NAME=your_sheet_name # название листа в таблице
GOOGLE_SHEETS_START_ROW=1 # строка, с которой начать чтение
GOOGLE_SHEETS_END_ROW=10 # строка, которой закончить чтение
GOOGLE_SHEETS_START_LITERAL=A # буква, с которой начать чтение
GOOGLE_SHEETS_END_LITERAL=J # буква, которой закончить чтение

# Параметры создания группы. Подробнее тут https://dev.vk.com/ru/method/groups.create https://dev.vk.com/ru/method/groups.edit
GROUP_CREATION_ACCESS=0
GROUP_CREATION_SUBJECT=1
GROUP_CREATION_WALL=1
GROUP_CREATION_TOPICS=1
GROUP_CREATION_PHOTOS=1
GROUP_CREATION_VIDEO=1
GROUP_CREATION_AUDIO=1
GROUP_CREATION_DOCS=1
GROUP_CREATION_WIKI=1

# DRY_RUN Значение типа bool. Если включено, то скрипт ничего не делает, а просто имитирует работу
DRY_RUN=True